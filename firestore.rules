rules_version = '2';

// Only signed-in Google accounts on the company domain may read or write
// anything in this database. Deploy with:
//   firebase deploy --only firestore:rules
// (or paste this file's contents into Firebase Console → Firestore Database
// → Rules → and click "Publish").
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email.matches('.*@1wan[.]ph$');
    }
  }
}
